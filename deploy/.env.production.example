# Settings for the server. Copy to .env in the repository root on the server, fill in, and keep it
# only there: never commit it or send it by email. compose.prod.yaml reads it.

# The site's address, without www (www redirects here). Caddy gets its certificate for both.
SITE_HOST=xenonfix.lv

# Database. Make up two long random passwords, e.g. with: openssl rand -base64 32
DB_USERNAME=xenonfix_app
DB_PASSWORD=
DB_ROOT_PASSWORD=

# First admin, created at the very first start only. The password must be changed at first login,
# after which these two lines can be removed.
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# Encrypts the admins' authenticator app keys in the database. Make it with: openssl rand -base64 32
# Keep a copy with the backups, somewhere other than the server: without it, a restored database
# needs every admin to set up the app again (another admin resets it, or by hand in the database).
APP_MFA_KEY=

# The mail server that sends from info@xenonfix.lv, from the email provider. Port 587 with STARTTLS.
# Emails go from and to info@xenonfix.lv (application.yml): do not set APP_MAIL_FROM or APP_MAIL_SHOP here.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
