# Local settings. dev-start.bat / dev-start.sh create .env from this with random passwords on the first run.
# Never commit .env.

# Database (Docker container "xenonfix-mariadb"; DBeaver: localhost:3308, database "xenonfix")
DB_PORT=3308
DB_URL=jdbc:mariadb://localhost:3308/xenonfix
DB_USERNAME=xenonfix_app
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# First admin, created at startup while there are no admins. Log in at http://localhost:4300/admin
APP_ADMIN_EMAIL=admin@xenonfix.test
APP_ADMIN_PASSWORD=change-me-please

# APP_MFA_KEY, which encrypts the admins' authenticator keys, is added at the end of .env by
# dev-start with a random value. Changing it means setting up the authenticator app again.

# Where uploaded files are stored. A relative path starts from backend/.
APP_UPLOADS_PATH=./uploads

# Email. Local development sends to Mailpit (see compose.yaml), which needs no settings.
# On a server, set SPRING_MAIL_HOST, SPRING_MAIL_PORT, SPRING_MAIL_USERNAME and SPRING_MAIL_PASSWORD.
# APP_MAIL_FROM=info@xenonfix.lv
# APP_MAIL_SHOP=info@xenonfix.lv

# To receive local test emails in a real mailbox, uncomment and fill in these, then restart with
# dev-stop and dev-start. Example for Gmail, which needs an app password, not the account password.
# The two addresses above must then be set to that mailbox too.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_AUTH=true
# MAIL_STARTTLS=true
