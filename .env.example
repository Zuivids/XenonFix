# Local settings. dev-start.bat / dev-start.sh create .env from this with random passwords on the first run.
# Never commit .env.

# Database (Docker container "xenonfix-mariadb"; DBeaver: localhost:3308, database "xenonfix")
DB_PORT=3308
DB_URL=jdbc:mariadb://localhost:3308/xenonfix
DB_USERNAME=xenonfix_app
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Where uploaded files are stored. A relative path starts from backend/.
APP_UPLOADS_PATH=./uploads
